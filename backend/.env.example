# Directory for SQLite metadata and uploaded files.
CRYOVAULT_DATA_DIR=./data

# Public frontend URL used to build share links in integrations.
CRYOVAULT_BASE_URL=http://localhost:5173

# Set a non-empty value before exposing the admin API beyond localhost.
CRYOVAULT_ADMIN_TOKEN=change-this-token

# 0 means unlimited upload size. Otherwise set bytes, e.g. 1073741824.
CRYOVAULT_MAX_UPLOAD_SIZE=0

# Maximum text file size opened in the browser editor (bytes).
CRYOVAULT_MAX_TEXT_EDIT_SIZE=5242880

# Set to true when CryoVault is served over HTTPS.
CRYOVAULT_COOKIE_SECURE=false

# Secret path for the admin console, e.g. /panel/3f9a2b...
# Leave empty in development. When set, "/" returns 404.
CRYOVAULT_PANEL_PATH=

# Expose /docs and /openapi.json. Disable in production.
CRYOVAULT_DOCS_ENABLED=true

# Trust X-Forwarded-For for login rate limiting. Enable only behind a proxy.
CRYOVAULT_TRUST_PROXY_HEADERS=false

# Extra CORS origins (JSON array). Empty means same-origin only.
CRYOVAULT_CORS_ORIGINS=[]

# --- Online updates ---------------------------------------------------
# Enabled automatically by one-click.sh (Linux + systemd installs).
CRYOVAULT_UPDATE_ENABLED=false
# Installer used to upgrade in place; must contain the --update-only entry.
CRYOVAULT_UPDATE_COMMAND=
# Upstream repository queried for the latest version.
CRYOVAULT_UPDATE_REPO=HlONGlin/CryoVault
CRYOVAULT_UPDATE_BRANCH=main
# Optional token to raise the GitHub API rate limit.
CRYOVAULT_GITHUB_TOKEN=
